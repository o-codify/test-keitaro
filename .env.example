# Обязательные параметры помечены [обязательно]: без них приложение не стартует
# и пишет, что именно не задано. У остальных в скобках указано значение по умолчанию.

# --- Keitaro ---
# [обязательно] true — фейковый Keitaro в памяти (без ключа); false — реальный трекер
KEITARO_MOCK=true
# Адрес трекера без /admin_api/v1 (обязателен при KEITARO_MOCK=false)
KEITARO_URL=
# Admin API key: Keitaro -> Maintenance -> Users -> API keys (обязателен при KEITARO_MOCK=false)
KEITARO_API_KEY=
# Таймаут запросов к Keitaro, секунды (20)
KEITARO_TIMEOUT=20

# --- База данных (SQLAlchemy URL) ---
# (пусто = SQLite в backend/app.db). Для Postgres:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/keitaro_wrapper
DATABASE_URL=

# --- Правила создания кампаний ---
# [обязательно] Префикс названий кампаний: test_<фамилия>_
CAMPAIGN_PREFIX=test_chalimov_
# [обязательно] Куда поток #1 редиректит посетителей из выбранных стран
GEO_REDIRECT_URL=https://google.com
# ID домена / группы / источника, подставляемые в форму (пусто = выбрать в форме)
DEFAULT_DOMAIN_ID=
DEFAULT_GROUP_ID=
DEFAULT_TRAFFIC_SOURCE_ID=

# Сколько секунд кэшировать список офферов для автокомплита (300)
OFFER_CACHE_TTL_SECONDS=300
